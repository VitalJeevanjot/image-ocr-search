  "devDependencies": {
    "@quasar/app-vite": "^1.3.0",
    "autoprefixer": "^10.4.2",
    "electron": "^27.0.2",
    "electron-builder": "^24.3.0",
    "electron-packager": "^17.1.1",
    "eslint": "^8.10.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-plugin-vue": "^9.0.0",
    "playwright-core": "^1.48.0",
    "postcss": "^8.4.14",
    "prettier": "^2.5.1"
